# ============ 说明：这些配置全部可选 ============
# AI 评阅默认由浏览器直连模型，密钥在网页「设置」面板里填，存在用户自己的 localStorage。
# 因此**新部署不需要在这里配任何东西**，也不需要在 EdgeOne 控制台配环境变量。
# 下面这些只在两种情况有用：① 站点想自带一把 Key 给访客用；② 想测中继通道。

# ---------- 服务端（仅供 /api/review 中继使用）----------
# 只在云函数运行时读取（context.env），切勿加 VITE_ 前缀 —— VITE_ 变量会被打进前端产物。
# 请求头带 x-api-key 时优先用用户自己的 Key，这里的值只是兜底。
DEEPSEEK_API_KEY=

# 中继侧的网关与模型（可选，留空用默认值）
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 置 1 时中继返回确定性 Mock 结果，不消耗额度、不访问外网。
# 用于联调界面或演示；线上务必为 0 或留空。
REVIEW_MOCK=0

# ---------- 前端（构建期，一般不用动）----------
# 中继接口地址。默认 /api/review（同源）。仅当函数部署在别的域名时才需要覆盖。
# VITE_REVIEW_API=https://example.com/api/review

# 前端强制示例模式（构建期）。等价于在设置面板里打开「示例模式」。
# 正常构建不要开。
# VITE_REVIEW_MOCK=0

# ---------- 本地联调 ----------
# vite dev server 把 /api 代理到这个地址（edgeone makers dev 默认 8088）。
# 只测直连时不需要启动函数，也就不需要这一项。
# EO_DEV_ORIGIN=http://127.0.0.1:8088
